<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Organizations</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>Service Organizations</h1>
  <ul>
    <% organizations.forEach(function(org) { %>
      <li>
        <h2><%= org.name %></h2>
        <p><%= org.description %></p>
        <% if (org.website) { %>
          <p><a href="<%= org.website %>" target="_blank"><%= org.website %></a></p>
        <% } %>
      </li>
    <% }); %>
  </ul>
  <p><a href="/">Home</a> | <a href="/projects">Projects</a> | <a href="/categories">Categories</a></p>
</body>
</html>
